# Commerce database connection (same DB as portal)
COMMERCE_DATABASE_URL=postgresql://user:pass@localhost:5432/commerce

# Site configuration (set per-site)
CHANNEL_ID=1
SITE_URL=https://store.example.com
# Set to "true" only on a public, indexable storefront. When unset/false the
# site serves robots.txt "Disallow: /" and an empty sitemap (build/test mirror).
SITE_INDEXABLE=false

# Session secret for customer auth (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-secret

# Google OAuth (same client ID as portal)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Google Gemini API (for product embeddings / semantic search)
GOOGLE_API_KEY=your-google-api-key

# Google Places API (New) — server key powering checkout address autocomplete.
# REQUIRED for the address lookup fields; the feature is silently disabled
# without it. Must be a key from the Keenan GCP project with the Places API
# (New) enabled and billing attached, restricted to places.googleapis.com and
# with NO HTTP-referrer restriction (it is called server-side, never from the
# browser). GOOGLE_API_KEY is NOT a substitute — it is blocked for Places.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Meilisearch (product search)
MEILI_URL=http://localhost:7700
MEILI_API_KEY=dev-key

# E2E test login bypass — OPTIONAL. Leave UNSET in production to disable the
# route entirely (POST /api/test/login returns 404 when this is empty). When
# set, the route signs a session cookie for a test account given { secret,
# email }, but ONLY for emails on E2E_EMAIL_DOMAIN. See tests/e2e/README.md.
E2E_LOGIN_SECRET=
E2E_EMAIL_DOMAIN=e2e.test

# Membership staff/QA test card — entering this on the subscribe form creates an
# active membership with no Stripe charge. DISABLED unless set (no built-in
# default) and ALWAYS disabled when NODE_ENV=production. Leave UNSET in prod.
MEMBERSHIP_TEST_CARD=

# Admin "Log-in as Contact" impersonation bridge (portal → storefront, B3).
# Verifies a short-lived HMAC token minted by the portal and establishes a real
# customer session. INERT unless set: GET /api/impersonate returns 404 when empty.
# MUST match the SAME value set in the PORTAL container. openssl rand -hex 32
IMPERSONATION_SECRET=

# ── Abuse guard (rate limiting + temporary bans) ────────────────────────────
# Second layer behind Cloudflare; it is what actually stops SUSTAINED scraping,
# because Cloudflare's free tier can only block for 10 seconds at a time.
#
# off = disabled · log = compute and log verdicts but block nothing · enforce = 429
# SHIP AS `log`, read a week of real traffic, then flip to `enforce`.
GUARD_MODE=log
# Trust CF-Connecting-IP. Leave FALSE until the EC2 security group only admits
# Cloudflare — until then any client can forge the header straight at the origin,
# minting unlimited buckets and framing real IPs into bans.
GUARD_TRUST_CF_IP=false
# Proxies between the internet and the app: 1 = Caddy only, 2 = Cloudflare → Caddy.
GUARD_XFF_TRUSTED_HOPS=1
# Comma-separated IPv4 CIDRs / bare IPs that bypass the guard entirely — a
# customer's office egress IP, uptime monitors, the deploy smoke test.
GUARD_ALLOW_IPS=
# Escalating ban durations in minutes; the last entry repeats.
GUARD_BAN_LADDER_MIN=15,60,360,1440
# Max distinct IPs tracked before LRU eviction (bans are capped separately).
GUARD_MAX_KEYS=20000
# Shown in the 429 body so a false positive has somewhere to go.
GUARD_CONTACT=
